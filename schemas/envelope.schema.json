{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.dev/schemas/envelope.schema.json",
  "title": "x402-shaped payment envelopes",
  "description": "Shape-compatible with x402 v2. network is always sim:aether-1. Do not vendor @x402/*.",
  "$defs": {
    "paymentRequired": {
      "type": "object",
      "required": ["x402Version", "resource", "accepted"],
      "properties": {
        "x402Version": { "const": 2 },
        "resource": {
          "type": "object",
          "required": ["url", "description", "mimeType"],
          "properties": {
            "url": { "type": "string" },
            "description": { "type": "string" },
            "mimeType": { "const": "application/json" }
          }
        },
        "accepted": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["scheme", "network", "amount", "asset", "payTo", "maxTimeoutSeconds"],
            "properties": {
              "scheme": { "enum": ["exact", "upto"] },
              "network": { "const": "sim:aether-1" },
              "amount": { "type": "string", "pattern": "^[0-9]+$" },
              "asset": { "enum": ["USD_SIM", "USDC_SIM"] },
              "payTo": { "type": "string", "pattern": "^acct_" },
              "maxTimeoutSeconds": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "paymentPayload": {
      "type": "object",
      "required": ["x402Version", "scheme", "network", "payload"],
      "properties": {
        "x402Version": { "const": 2 },
        "scheme": { "enum": ["exact", "upto"] },
        "network": { "const": "sim:aether-1" },
        "payload": {
          "type": "object",
          "required": ["payerAccountId", "paymentMandateId", "nonce", "authorizedAmount", "asset", "validBefore", "signature"],
          "properties": {
            "payerAccountId": { "type": "string" },
            "paymentMandateId": { "type": "string" },
            "nonce": { "type": "string" },
            "authorizedAmount": { "type": "string" },
            "asset": { "enum": ["USD_SIM", "USDC_SIM"] },
            "validBefore": { "type": "string", "format": "date-time" },
            "signature": { "type": "string" }
          }
        }
      }
    },
    "settlementResponse": {
      "type": "object",
      "required": ["success", "transaction", "network", "payer"],
      "properties": {
        "success": { "type": "boolean" },
        "transaction": { "type": ["string", "null"] },
        "network": { "const": "sim:aether-1" },
        "payer": { "type": ["string", "null"] },
        "errorReason": { "type": "string" },
        "receiptId": { "type": "string" }
      }
    }
  }
}
