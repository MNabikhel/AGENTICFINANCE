{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.dev/schemas/policy.schema.json",
  "title": "PolicyDecision",
  "type": "object",
  "required": ["verdict", "trace"],
  "properties": {
    "verdict": { "enum": ["allow", "deny", "escalate"] },
    "approvalId": { "type": "string", "pattern": "^apd_" },
    "trace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ruleId", "verdict", "message"],
        "properties": {
          "ruleId": { "type": "string" },
          "verdict": { "enum": ["allow", "deny", "escalate"] },
          "message": { "type": "string" },
          "evidence": { "type": "object" }
        }
      }
    }
  }
}
